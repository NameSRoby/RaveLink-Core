<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile the production host for CodeQL with Windows framework references. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RaveLink-Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <LangVersion>5</LangVersion>
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>none</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/RaveLink-Core.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RaveLinkCoreHost.cs" />
    <Compile Include="DashboardWindow.cs" />
    <Compile Include="DesktopPolicy.cs" />
    <Compile Include="DesktopBrowserActions.cs" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.Web.WebView2.Core"><HintPath>../../runtime/desktop/Microsoft.Web.WebView2.Core.dll</HintPath></Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms"><HintPath>../../runtime/desktop/Microsoft.Web.WebView2.WinForms.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RestoreWebView2" BeforeTargets="ResolveAssemblyReferences">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/restore-webview2.ps1&quot;" />
  </Target>
</Project>
