<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile the production host for CodeQL with Windows framework references. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RaveLink-Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <LangVersion>5</LangVersion>
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>none</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/RaveLink-Core.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RaveLinkCoreHost.cs" />
  </ItemGroup>
</Project>
