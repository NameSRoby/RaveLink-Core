{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saved baseline lighting groups",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "revision", "groups"],
  "properties": {
    "version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "groups": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "fixtureIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9-]{1,64}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(?!.*[\\u0000-\\u001f\\u007f]).*\\S.*$" },
          "fixtureIds": {
            "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!.*[\\u0000-\\u001f\\u007f]).*\\S.*$" }
          }
        }
      }
    }
  }
}
