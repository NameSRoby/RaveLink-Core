{
  "name": "ravelink-core",
  "version": "0.7.4-a",
  "releaseVersion": "0.7.4a",
  "description": "RaveLink Core for modular local lighting, Twitch, and creator features on Windows",
  "license": "Apache-2.0",
  "homepage": "https://github.com/NameSRoby/RaveLink-Core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NameSRoby/RaveLink-Core.git"
  },
  "bugs": {
    "url": "https://github.com/NameSRoby/RaveLink-Core/issues"
  },
  "main": "src/app/core/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/app/optional/feature-enabled-server.js",
    "setup:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-source.ps1 -NoStart",
    "build:host": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-host.ps1",
    "build:audio": "node scripts/build-music-to-light-probe.js",
    "start:core": "node src/app/core/index.js",
    "start:mods": "node src/app/optional/combined-enabled-server.js",
    "tidal:companion": "node scripts/manage-tidal-desktop.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\" \"integrations/music-to-light/test/*.test.cjs\"",
    "format": "node scripts/format-source.js --write",
    "format:check": "node scripts/format-source.js",
    "lint": "eslint src features public/core integrations scripts packages && node scripts/lint-html-scripts.js",
    "build:generated": "node scripts/build-song-overlay-ui.js && node scripts/build-song-player-providers.js && node scripts/build-playlist-transfers.js && node scripts/build-spotify-desktop.js && node scripts/build-tidal-desktop.js && node scripts/build-music-to-light-ui.js && node scripts/refresh-feature-integrity.js",
    "verify:generated": "node scripts/verify-generated.js",
    "verify:health": "npm run format:check && npm run lint && node scripts/audit-repository-health.js && node scripts/verify-source-structure.js && npm run verify:generated"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "bonjour-service": "^1.4.4",
    "cross-fetch": "3.1.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "yauzl": "3.4.0",
    "youtubei.js": "18.1.0"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "espree": "11.2.0",
    "parse5": "8.0.1",
    "playwright": "^1.58.2",
    "prettier": "3.9.10",
    "yazl": "3.3.1"
  },
  "optionalDependencies": {
    "hue-sync": "^0.1.3",
    "node-dtls-client": "^1.1.1"
  },
  "overrides": {
    "path-to-regexp": "8.4.2"
  }
}
