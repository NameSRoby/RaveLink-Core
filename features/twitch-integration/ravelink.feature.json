{
  "schemaVersion": 1,
  "id": "twitch-integration",
  "name": "Twitch Integration",
  "description": "Optional Twitch Device Code authorization, redemption settlement, EventSub foundation, and chat transport.",
  "version": "0.12.2",
  "publisher": "ravelink",
  "entry": "dist/main.js",
  "engine": {
    "featureApi": "^1.0.0",
    "node": ">=22"
  },
  "consumes": [
    "twitch.host.v1"
  ],
  "provides": [
    "twitch.connection.read.v1",
    "twitch.oauth.admin.v1",
    "twitch.monitor.admin.v1",
    "twitch.rewards.read.v1",
    "twitch.rewards.admin.v1",
    "twitch.redemptions.v1",
    "twitch.chat.send.v1",
    "twitch.rewards.catalog.v1"
  ],
  "contracts": [
    "contracts/twitch-integration-v1.contracts.json"
  ],
  "permissions": {
    "network": [
      "id.twitch.tv",
      "api.twitch.tv",
      "eventsub.wss.twitch.tv"
    ],
    "storage": false,
    "secrets": [
      "twitch.oauth.tokens"
    ],
    "process": false,
    "hardware": []
  },
  "resources": {
    "idleCpuPercent": 0.1,
    "idleRssMiB": 48,
    "activeRssMiB": 64,
    "timers": 1,
    "minTimerMs": 1000,
    "ipcFrameBytes": 32768,
    "inFlightCalls": 2,
    "queuedCalls": 4,
    "externalInFlight": 1,
    "storageBytes": 0,
    "historyEntries": 128,
    "shutdownGraceMs": 1500
  },
  "contributes": {
    "pages": [
      {
        "id": "connection",
        "title": "Connection",
        "entry": "ui/connection.html",
        "surface": "panel",
        "embedHosts": [],
        "imageHosts": [],
        "capabilities": [
          "twitch.connection.read.v1",
          "twitch.oauth.admin.v1",
          "twitch.monitor.admin.v1",
          "twitch.rewards.read.v1",
          "twitch.rewards.admin.v1",
          "twitch.redemptions.v1"
        ]
      }
    ]
  },
  "integrity": {
    "algorithm": "sha256",
    "files": {
      "contracts/twitch-integration-v1.contracts.json": "5ec0dcec7dc34a902c938d9767e4ca1bc34c4d0fb7c0b253bc3a4b2b48ab364d",
      "dist/main.js": "0a404c12adb4b996b81badef92db31837f39864adf18c12e2d65bdd4e208a94a",
      "ui/connection.html": "f758ab7433b8c0bb3789eaf09e0835abc9dc6e4c5f726acd52616f768691b72b"
    }
  }
}
