{
  "schemaVersion": 1,
  "id": "twitch-integration",
  "name": "Twitch Integration",
  "description": "Optional Twitch Device Code authorization, redemption settlement, EventSub foundation, and chat transport.",
  "version": "0.12.1",
  "publisher": "ravelink",
  "entry": "dist/main.js",
  "engine": {
    "featureApi": "^1.0.0",
    "node": ">=22"
  },
  "consumes": [
    "twitch.host.v1"
  ],
  "provides": [
    "twitch.connection.read.v1",
    "twitch.oauth.admin.v1",
    "twitch.monitor.admin.v1",
    "twitch.rewards.read.v1",
    "twitch.rewards.admin.v1",
    "twitch.redemptions.v1",
    "twitch.chat.send.v1",
    "twitch.rewards.catalog.v1"
  ],
  "contracts": [
    "contracts/twitch-integration-v1.contracts.json"
  ],
  "permissions": {
    "network": [
      "id.twitch.tv",
      "api.twitch.tv",
      "eventsub.wss.twitch.tv"
    ],
    "storage": false,
    "secrets": [
      "twitch.oauth.tokens"
    ],
    "process": false,
    "hardware": []
  },
  "resources": {
    "idleCpuPercent": 0.1,
    "idleRssMiB": 48,
    "activeRssMiB": 64,
    "timers": 1,
    "minTimerMs": 1000,
    "ipcFrameBytes": 32768,
    "inFlightCalls": 2,
    "queuedCalls": 4,
    "externalInFlight": 1,
    "storageBytes": 0,
    "historyEntries": 128,
    "shutdownGraceMs": 1500
  },
  "contributes": {
    "pages": [
      {
        "id": "connection",
        "title": "Connection",
        "entry": "ui/connection.html",
        "surface": "panel",
        "embedHosts": [],
        "imageHosts": [],
        "capabilities": [
          "twitch.connection.read.v1",
          "twitch.oauth.admin.v1",
          "twitch.monitor.admin.v1",
          "twitch.rewards.read.v1",
          "twitch.rewards.admin.v1",
          "twitch.redemptions.v1"
        ]
      }
    ]
  },
  "integrity": {
    "algorithm": "sha256",
    "files": {
      "contracts/twitch-integration-v1.contracts.json": "71efdbb31320fce708bf0be5a7803f0c8a4f821dcfd66c9765b9f745908f29f5",
      "dist/main.js": "73b996b9532d8b1bb74b5a40be59c5999cb673b73352acdfd7e40717c96dfaa4",
      "ui/connection.html": "6b02f8f6c7b1d793a709a344dcceff43111b50c249f8ddce85bba13d4a8ac610"
    }
  }
}
