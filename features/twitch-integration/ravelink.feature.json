{
  "schemaVersion": 1,
  "id": "twitch-integration",
  "name": "Twitch Integration",
  "description": "Optional Twitch Device Code authorization, redemption settlement, EventSub foundation, and chat transport.",
  "version": "0.10.3",
  "publisher": "ravelink",
  "entry": "dist/main.js",
  "engine": {
    "featureApi": "^1.0.0",
    "node": ">=22"
  },
  "consumes": [
    "twitch.host.v1"
  ],
  "provides": [
    "twitch.connection.read.v1",
    "twitch.oauth.admin.v1",
    "twitch.monitor.admin.v1",
    "twitch.rewards.read.v1",
    "twitch.rewards.admin.v1",
    "twitch.redemptions.v1",
    "twitch.chat.send.v1",
    "twitch.rewards.catalog.v1"
  ],
  "contracts": [
    "contracts/twitch-integration-v1.contracts.json"
  ],
  "permissions": {
    "network": [
      "id.twitch.tv",
      "api.twitch.tv",
      "eventsub.wss.twitch.tv"
    ],
    "storage": false,
    "secrets": [
      "twitch.oauth.tokens"
    ],
    "process": false,
    "hardware": []
  },
  "resources": {
    "idleCpuPercent": 0.1,
    "idleRssMiB": 48,
    "activeRssMiB": 64,
    "timers": 1,
    "minTimerMs": 1000,
    "ipcFrameBytes": 32768,
    "inFlightCalls": 2,
    "queuedCalls": 4,
    "externalInFlight": 1,
    "storageBytes": 0,
    "historyEntries": 128,
    "shutdownGraceMs": 1500
  },
  "contributes": {
    "pages": [
      {
        "id": "connection",
        "title": "Connection",
        "entry": "ui/connection.html",
        "surface": "panel",
        "embedHosts": [],
        "imageHosts": [],
        "capabilities": [
          "twitch.connection.read.v1",
          "twitch.oauth.admin.v1",
          "twitch.monitor.admin.v1",
          "twitch.rewards.read.v1",
          "twitch.rewards.admin.v1"
        ]
      }
    ]
  },
  "integrity": {
    "algorithm": "sha256",
    "files": {
      "contracts/twitch-integration-v1.contracts.json": "0f274c0b01c1612ec07131c686eb1a4b9da96fbe5704e3f167dbb418ad60274e",
      "dist/main.js": "1e0a06ed6e466bc56b49fc2f675c3a07efe3d49e8eaa8504a2548aa88819f701",
      "ui/connection.html": "6ebc457f5614003fe24529b2cea2fb901c96c21da8247704d9dd0b1efc32d255"
    }
  }
}
