    {
      "capability": "twitch.rewards.admin.v1",
      "methods": {
        "create": {
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "purpose",
              "title",
              "cost"
            ],
            "properties": {
              "purpose": {
                "enum": [
                  "lights",
                  "teach",
                  "song_request"
