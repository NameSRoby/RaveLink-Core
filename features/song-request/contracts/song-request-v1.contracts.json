              "policy": { "type": "object" }
            }
          },
          "response": {
            "type": "object",
            "required": ["ok"],
            "properties": {
              "ok": { "type": "boolean" },
              "configured": { "type": "boolean" },
              "mode": { "type": "string", "enum": ["keyless", "official"] },
              "error": { "type": "string", "maxLength": 80 },
              "policy": { "type": "object" }
            }
          }
        },
        "clear": {
          "request": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {}
          },
          "response": {
            "type": "object",
            "required": ["ok", "configured"],
            "properties": {
              "ok": { "type": "boolean" },
              "configured": { "type": "boolean" },
              "error": { "type": "string", "maxLength": 80 }
            }
          }
        }
