                "maxLength": 40
              },
              "playbackSource": {
                "enum": [
                  "youtube",
                  "tidal",
                  "spotify",
                  "apple-music"
                ]
              },
              "selectedProvider": {
                "enum": [
                  "tidal",
                  "spotify",
                  "apple-music"
                ]
              },
              "error": {
                "type": "string",
                "maxLength": 80
              },
              "pid": {
                "type": "integer",
                "minimum": 0
              },
              "lastObservedAt": {
                "type": "integer",
                "minimum": 0
              },
              "lastError": {
                "type": "string",
                "maxLength": 80
              },
              "forwarding": {
                "type": "boolean"
              },
