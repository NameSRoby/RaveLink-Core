    {
      "capability": "song.catalog.read.v1",
      "methods": {
        "status": {
          "request": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {}
          },
          "response": {
            "type": "object",
            "required": ["ok", "configured", "policy"],
            "properties": {
              "ok": { "type": "boolean" },
              "configured": { "type": "boolean" },
              "mode": { "type": "string", "enum": ["keyless", "official"] },
              "officialConfigured": { "type": "boolean" },
              "keylessAvailable": { "type": "boolean" },
              "availableModes": { "type": "array", "maxItems": 2, "items": { "type": "string", "enum": ["keyless", "official"] } },
