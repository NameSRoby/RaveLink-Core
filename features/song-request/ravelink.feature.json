          "song.playback.read.v1",
          "song.playback.events.v1"
        ]
      },
      {
        "id": "obs-overlay",
        "title": "OBS Overlay",
        "entry": "ui/obs-overlay.html",
        "surface": "overlay",
        "embedHosts": [],
        "imageHosts": [
          "i.ytimg.com"
        ],
        "capabilities": [
          "song.queue.read.v1",
          "song.queue.events.v1",
          "song.playback.read.v1",
          "song.playback.events.v1",
          "song.overlay.read.v1",
          "song.overlay.events.v1"
        ]
      },
      {
        "id": "overlay-editor",
