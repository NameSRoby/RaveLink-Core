{
  "schemaVersion": 1,
  "id": "song-request",
  "name": "Song Request",
  "description": "Song Request with YouTube search, official embedded playback, playlists, moderation, and a configurable now-playing overlay.",
  "version": "0.13.7",
  "publisher": "ravelink",
  "entry": "dist/main.js",
  "engine": {
    "featureApi": "^1.0.0",
    "node": ">=22"
