{
  "schemaVersion": 1,
  "id": "song-request",
  "name": "Song Request",
  "description": "YouTube Song Request with playlists, moderation, and an overlay that can also observe supported Windows media sessions.",
  "version": "0.13.8",
  "publisher": "ravelink",
  "entry": "dist/main.js",
  "engine": {
    "featureApi": "^1.0.0",
    "node": ">=22"
  },
  "consumes": [
    "ravelink.storage.v1?",
    "twitch.chat.send.v1?",
    "widget.state.v1?",
    "twitch.redemptions.v1?",
    "twitch.rewards.manage.v1?",
    "diagnostics.publish.v1?",
    "media.windows.now-playing.v1?",
    "youtube.catalog.host.v1?"
  ],
  "provides": [
    "song.playlist.read.v1",
    "song.playlist.admin.v1",
    "song.queue.read.v1",
    "song.queue.submit.v1",
    "song.queue.admin.v1",
    "song.queue.events.v1",
    "song.playback.read.v1",
    "song.playback.driver.v1",
    "song.playback.observe.v1",
