    "song.catalog.read.v1",
    "song.catalog.admin.v1"
  ],
  "contracts": [
    "contracts/song-request-v1.contracts.json"
  ],
  "permissions": {
    "network": [],
    "storage": true,
    "secrets": [],
    "process": false,
    "hardware": []
  },
  "resources": {
    "idleCpuPercent": 0.1,
    "idleRssMiB": 32,
    "activeRssMiB": 64,
    "timers": 1,
    "minTimerMs": 1000,
    "ipcFrameBytes": 65536,
    "inFlightCalls": 2,
    "queuedCalls": 8,
    "externalInFlight": 0,
    "storageBytes": 8388608,
    "historyEntries": 250,
    "shutdownGraceMs": 1500
  },
