    "pages": [
      {
        "id": "player",
        "title": "Player",
        "entry": "ui/player.html",
        "surface": "panel",
        "embedHosts": [
          "www.youtube.com"
        ],
        "imageHosts": [],
        "capabilities": [
          "song.queue.read.v1",
          "song.queue.submit.v1",
          "song.queue.admin.v1",
          "song.queue.events.v1",
          "song.playback.read.v1",
