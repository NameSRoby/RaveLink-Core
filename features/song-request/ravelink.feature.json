          "song.catalog.read.v1",
          "song.catalog.admin.v1"
        ]
      },
      {
        "id": "request-queue",
        "title": "Request Queue",
        "entry": "ui/request-queue.html",
        "surface": "panel",
        "embedHosts": [],
        "imageHosts": [],
        "capabilities": [
          "song.queue.read.v1",
          "song.queue.admin.v1",
          "song.queue.events.v1",
          "song.playback.events.v1"
