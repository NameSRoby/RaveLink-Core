{
  "schemaVersion": 1,
  "id": "song-request",
  "name": "Song Request",
  "description": "First-party YouTube and optional SoundCloud Song Request with official playback widgets and a provider-neutral now-playing overlay.",
  "version": "0.13.1",
  "publisher": "ravelink",
  "entry": "dist/main.js",
  "engine": {
    "featureApi": "^1.0.0",
    "node": ">=22"
  },
  "consumes": [
    "ravelink.storage.v1?",
    "twitch.chat.send.v1?",
    "widget.state.v1?",
    "twitch.redemptions.v1?",
    "twitch.rewards.manage.v1?",
    "diagnostics.publish.v1?",
    "media.windows.now-playing.v1?",
    "youtube.catalog.host.v1?",
    "soundcloud.catalog.v1?"
  ],
  "provides": [
    "song.playlist.read.v1",
    "song.playlist.admin.v1",
    "song.queue.read.v1",
    "song.queue.submit.v1",
    "song.queue.admin.v1",
    "song.queue.events.v1",
    "song.playback.read.v1",
    "song.playback.driver.v1",
    "song.playback.observe.v1",
    "song.playback.events.v1",
    "song.observer.admin.v1",
    "song.overlay.read.v1",
    "song.overlay.admin.v1",
    "song.overlay.events.v1",
    "song.catalog.read.v1",
    "song.catalog.admin.v1"
  ],
  "contracts": [
    "contracts/song-request-v1.contracts.json"
  ],
  "permissions": {
    "network": [],
    "storage": true,
    "secrets": [],
    "process": false,
    "hardware": []
  },
  "resources": {
    "idleCpuPercent": 0.1,
    "idleRssMiB": 32,
    "activeRssMiB": 64,
    "timers": 1,
    "minTimerMs": 1000,
    "ipcFrameBytes": 65536,
    "inFlightCalls": 2,
    "queuedCalls": 8,
    "externalInFlight": 0,
    "storageBytes": 8388608,
    "historyEntries": 250,
    "shutdownGraceMs": 1500
  },
  "contributes": {
    "pages": [
      {
        "id": "player",
        "title": "Player",
        "entry": "ui/player.html",
        "surface": "panel",
        "embedHosts": [
          "www.youtube.com",
          "w.soundcloud.com"
        ],
        "imageHosts": [],
        "capabilities": [
          "song.queue.read.v1",
          "song.queue.submit.v1",
          "song.queue.admin.v1",
          "song.queue.events.v1",
          "song.playback.read.v1",
          "song.playback.driver.v1",
          "song.playback.events.v1",
          "song.catalog.read.v1",
          "song.catalog.admin.v1"
        ]
      },
      {
        "id": "request-queue",
        "title": "Request Queue",
        "entry": "ui/request-queue.html",
        "surface": "panel",
        "embedHosts": [],
        "imageHosts": [],
        "capabilities": [
          "song.queue.read.v1",
          "song.queue.admin.v1",
          "song.queue.events.v1",
          "song.playback.events.v1"
        ]
      },
      {
        "id": "server-playlist",
        "title": "Server Playlist",
        "entry": "ui/server-playlist.html",
        "surface": "panel",
        "embedHosts": [],
        "imageHosts": [],
        "capabilities": [
          "song.playlist.read.v1",
          "song.playlist.admin.v1",
          "song.queue.read.v1",
          "song.queue.admin.v1",
          "song.queue.events.v1",
          "song.playback.events.v1"
        ]
      },
      {
        "id": "now-playing",
        "title": "Now Playing Sources",
        "entry": "ui/now-playing.html",
        "surface": "panel",
        "embedHosts": [],
        "imageHosts": [],
        "capabilities": [
          "song.observer.admin.v1",
          "song.playback.read.v1",
          "song.playback.events.v1"
        ]
      },
      {
        "id": "obs-overlay",
        "title": "OBS Overlay",
        "entry": "ui/obs-overlay.html",
        "surface": "overlay",
        "embedHosts": [],
        "imageHosts": [
          "i.ytimg.com"
        ],
        "capabilities": [
          "song.queue.read.v1",
          "song.queue.events.v1",
          "song.playback.read.v1",
          "song.playback.events.v1",
          "song.overlay.read.v1",
          "song.overlay.events.v1"
        ]
      },
      {
        "id": "overlay-editor",
        "title": "Overlay Designer",
        "entry": "ui/overlay-editor.html",
        "surface": "panel",
        "embedHosts": [],
        "imageHosts": [],
        "capabilities": [
          "song.overlay.read.v1",
          "song.overlay.admin.v1",
          "song.overlay.events.v1"
        ]
      }
    ]
  },
