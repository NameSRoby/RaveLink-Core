{
  "schemaVersion": 1,
  "contracts": [
    {
      "capability": "soundcloud.connection.read.v1",
      "methods": {
        "status": {
          "request": { "type": ["object", "null"], "additionalProperties": false, "properties": {} },
          "response": { "$ref": "#/$defs/status" }
        }
      }
    },
    {
      "capability": "soundcloud.credentials.admin.v1",
      "methods": {
        "configure": {
          "request": {
            "type": "object", "additionalProperties": false, "required": ["clientId", "clientSecret"],
            "properties": {
              "clientId": { "type": "string", "minLength": 8, "maxLength": 200 },
              "clientSecret": { "type": "string", "minLength": 16, "maxLength": 300 }
            }
          },
          "response": { "$ref": "#/$defs/status" }
        },
        "clear": {
          "request": { "type": ["object", "null"], "additionalProperties": false, "properties": {} },
          "response": { "$ref": "#/$defs/status" }
        }
      }
    },
    {
      "capability": "soundcloud.catalog.v1",
      "methods": {
        "status": {
          "request": { "type": ["object", "null"], "additionalProperties": false, "properties": {} },
          "response": { "$ref": "#/$defs/status" }
        },
        "resolve": {
          "request": {
            "type": "object", "additionalProperties": false, "required": ["query"],
            "properties": { "query": { "type": "string", "minLength": 1, "maxLength": 300 }, "maxDurationMs": { "type": "integer", "minimum": 0, "maximum": 86400000 } }
          },
          "response": { "type": "object", "required": ["ok"], "properties": { "ok": { "type": "boolean" }, "candidate": { "type": "object" }, "evidence": { "type": "object" }, "reason": { "type": "string", "maxLength": 120 } } }
        },
        "import-playlist-start": {
          "request": { "type": "object", "additionalProperties": false, "required": ["url"], "properties": { "url": { "type": "string", "minLength": 1, "maxLength": 500 }, "limit": { "type": "integer", "minimum": 1, "maximum": 2500 } } },
          "response": { "$ref": "#/$defs/job" }
        },
        "import-playlist-status": {
          "request": { "$ref": "#/$defs/jobRequest" },
          "response": { "$ref": "#/$defs/job" }
        },
        "import-playlist-page": {
          "request": { "type": "object", "additionalProperties": false, "required": ["jobId"], "properties": { "jobId": { "type": "string", "maxLength": 80 }, "offset": { "type": "integer", "minimum": 0 }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 } } },
          "response": { "type": "object", "required": ["ok"], "properties": { "ok": { "type": "boolean" }, "error": { "type": "string", "maxLength": 120 }, "items": { "type": "array", "maxItems": 100 }, "offset": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0, "maximum": 2500 }, "hasMore": { "type": "boolean" } } }
        },
        "import-playlist-cancel": {
          "request": { "$ref": "#/$defs/jobRequest" },
          "response": { "$ref": "#/$defs/job" }
        }
      }
    }
  ],
  "$defs": {
    "status": {
      "type": "object", "required": ["ok", "configured", "available", "credentials", "tokenCached", "vault", "cacheEntries", "limits", "lastError"],
      "properties": {
        "ok": { "type": "boolean" }, "configured": { "type": "boolean" }, "available": { "type": "boolean" },
        "credentials": { "type": "object" }, "tokenCached": { "type": "boolean" }, "vault": { "type": "string", "maxLength": 40 },
        "cacheEntries": { "type": "integer", "minimum": 0, "maximum": 100 }, "limits": { "type": "object" },
        "lastError": { "type": "string", "maxLength": 120 }, "error": { "type": "string", "maxLength": 120 }
      }
    },
    "jobRequest": { "type": "object", "additionalProperties": false, "required": ["jobId"], "properties": { "jobId": { "type": "string", "maxLength": 80 } } },
    "job": {
      "type": "object", "required": ["ok"],
      "properties": {
        "ok": { "type": "boolean" }, "jobId": { "type": "string", "maxLength": 80 }, "state": { "type": "string", "maxLength": 20 },
        "playlistId": { "type": "string", "maxLength": 160 }, "title": { "type": "string", "maxLength": 120 },
        "count": { "type": "integer", "minimum": 0, "maximum": 2500 }, "truncated": { "type": "boolean" },
        "error": { "type": "string", "maxLength": 120 }
      }
    }
  }
}
