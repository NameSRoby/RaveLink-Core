                  "pitch": { "type": "number", "minimum": 0.5, "maximum": 2 },
                  "queuePolicy": { "enum": ["queue", "replace", "skip-when-busy"] }
                }
              },
              "packages": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "name", "version", "description", "installed", "installedVersion", "updateAvailable", "bytes", "source", "downloadRequired"],
                  "properties": {
                    "id": { "type": "string", "maxLength": 64 },
