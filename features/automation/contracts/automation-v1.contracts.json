                    "version": { "type": "string", "maxLength": 40 },
                    "description": { "type": "string", "maxLength": 500 },
                    "installed": { "type": "boolean" },
                    "installedVersion": { "type": "string", "maxLength": 40 },
                    "updateAvailable": { "type": "boolean" },
                    "bytes": { "type": "integer", "minimum": 0, "maximum": 2147483648 },
                    "source": { "const": "github" },
                    "downloadRequired": { "const": true }
                  }
                }
              }
            }
          }
        },
