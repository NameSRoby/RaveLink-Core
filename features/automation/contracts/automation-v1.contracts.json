                "required": ["engineName", "engineVersion", "voices", "outputs", "active", "queued"],
                "properties": {
                  "engineName": { "type": "string", "maxLength": 80 },
                  "engineVersion": { "type": "string", "maxLength": 40 },
                  "active": { "type": "boolean" },
                  "queued": { "type": "integer", "minimum": 0, "maximum": 10 },
