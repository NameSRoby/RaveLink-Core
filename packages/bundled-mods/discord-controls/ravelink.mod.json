{
  "schemaVersion": 1,
  "id": "ravelink.discord-controls",
  "name": "Discord audio controls",
  "description": "Independent Discord mute and deafen toggles with confirmed status. Does not launch, restart or close Discord.",
  "version": "1.0.1",
  "publisher": "ravelink",
  "license": "Apache-2.0",
  "entry": "main.js",
  "engine": { "ravelinkModApi": "^1.0.0", "node": ">=24" },
  "activationEvents": ["onEnable"],
  "consumes": ["discord.desktop.host.v1"],
  "provides": ["stream.discord.v1"],
  "permissions": {
    "network": [],
    "storage": false,
    "secrets": [],
    "ui": false,
    "process": false,
    "hardware": []
  },
  "resources": {
    "idleCpuPercent": 0.05,
    "idleRssMiB": 64,
    "activeRssMiB": 128,
    "timers": 0,
    "minTimerMs": 1000,
    "ipcFrameBytes": 32768,
    "inFlightCalls": 2,
    "queuedCalls": 8,
    "externalInFlight": 1,
    "storageBytes": 0,
    "historyEntries": 0,
    "shutdownGraceMs": 2000
  },
  "contributes": {
    "actions": [
      {
        "id": "microphone",
        "title": "Discord microphone",
        "description": "Toggle the bound Discord microphone and show its confirmed state. Bind Discord in button Setup first.",
        "symbol": "🎙",
        "capability": "stream.discord.v1",
        "method": "toggle",
        "stateMethod": "status",
        "defaults": {},
        "parameters": { "type": "object", "additionalProperties": false, "properties": {} }
      },
      {
        "id": "deafen",
        "title": "Discord deafen",
        "method": "toggleDeafen",
        "stateMethod": "deafenStatus",
        "symbol": "🎧",
        "capability": "stream.discord.v1",
        "defaults": {},
        "parameters": { "type": "object", "additionalProperties": false, "properties": {} }
      }
    ]
  },
  "integrity": {
    "algorithm": "sha256",
    "files": { "main.js": "d48753ddc9b2c625f37188b6fd4b72344612ee35a195327054742ae9a14c541e" }
  }
}
