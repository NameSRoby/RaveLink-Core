{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ravelink.local/schemas/mod-manifest-v1.schema.json",
  "title": "RaveLink Mod Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "publisher",
    "license",
    "entry",
    "engine",
    "activationEvents",
    "consumes",
    "provides",
    "permissions",
    "resources",
    "integrity"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}\\.[a-z0-9][a-z0-9-]{0,31}$", "maxLength": 64 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 500 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$", "maxLength": 64 },
    "publisher": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "license": { "type": "string", "minLength": 1, "maxLength": 80 },
    "entry": { "type": "string", "minLength": 1, "maxLength": 240 },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ravelinkModApi", "node"],
      "properties": {
        "ravelinkModApi": { "type": "string", "minLength": 1, "maxLength": 40 },
        "node": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "activationEvents": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "consumes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+\\.v[1-9][0-9]*\\??$", "maxLength": 100 }
    },
    "provides": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+\\.v[1-9][0-9]*$", "maxLength": 100 }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "maxLength": 253 } },
        "storage": { "type": "boolean" },
        "secrets": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" } },
        "ui": { "type": "boolean" },
        "process": { "type": "boolean" },
        "hardware": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" } }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panels"],
      "properties": {
        "panels": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "entry"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,39}$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 60 },
              "entry": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\\\/](?:.*[^\\\\/])?\\.html$" }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idleCpuPercent", "idleRssMiB", "activeRssMiB", "timers", "minTimerMs", "ipcFrameBytes", "inFlightCalls", "queuedCalls", "externalInFlight", "storageBytes", "historyEntries", "shutdownGraceMs"],
      "properties": {
        "idleCpuPercent": { "type": "number", "minimum": 0, "maximum": 0.25 },
        "idleRssMiB": { "type": "integer", "minimum": 8, "maximum": 64 },
        "activeRssMiB": { "type": "integer", "minimum": 8, "maximum": 192 },
        "timers": { "type": "integer", "minimum": 0, "maximum": 8 },
        "minTimerMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "ipcFrameBytes": { "type": "integer", "minimum": 1024, "maximum": 65536 },
        "inFlightCalls": { "type": "integer", "minimum": 1, "maximum": 4 },
        "queuedCalls": { "type": "integer", "minimum": 0, "maximum": 32 },
        "externalInFlight": { "type": "integer", "minimum": 0, "maximum": 2 },
        "storageBytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "historyEntries": { "type": "integer", "minimum": 0, "maximum": 250 },
        "shutdownGraceMs": { "type": "integer", "minimum": 100, "maximum": 3000 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "files"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "files": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 2048,
          "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
